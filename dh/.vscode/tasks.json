{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "compile (windows)",
			"command": "g++",
			"args": [
				"-fdiagnostics-color=always",
				"-std=c++11",
				"-g",
				"${file}",
				"-o",
				"${fileDirname}\\${fileBasenameNoExtension}.exe"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
		},
		{
			"type": "cppbuild",
			"label": "compile optimized (windows)",
			"command": "g++",
			"args": [
				"-fdiagnostics-color=always",
				"-std=c++11",
				"-O3", "-march=native",
				"${file}",
				"-o",
				"${fileDirname}\\${fileBasenameNoExtension}.exe"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
		},
		{
			"type": "cppbuild",
			"label": "compile (linux)",
			"command": "g++",
			"args": [
				"-fdiagnostics-color=always",
				"-std=c++11",
				"-g",
				"${file}",
				"-o",
				"${fileDirname}/${fileBasenameNoExtension}"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
		},
		{
			"type": "cppbuild",
			"label": "compile optimized (linux)",
			"command": "g++",
			"args": [
				"-fdiagnostics-color=always",
				"-std=c++11",
				"-O2", "-march=native",
				"${file}",
				"-o",
				"${fileDirname}/${fileBasenameNoExtension}"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
		}
	]
}